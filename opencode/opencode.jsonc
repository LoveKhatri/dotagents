{
  "plugin": [
    "opencode-antigravity-auth@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "default_agent": "plan",
  "provider": {
    "commandcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CommandCode",
      "options": {
        "baseURL": "http://localhost:55990/v1",
      },
      "models": {
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "reasoning": true,
          "tool_call": true,
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "reasoning": true,
          "tool_call": true,
        },
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi K2.7 Code",
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "reasoning": true,
          "tool_call": true,
        },
        "zai-org/GLM-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "reasoning": true,
          "tool_call": true,
        },
        "MiniMaxAI/MiniMax-M3": {
          "name": "MiniMax M3",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "reasoning": true,
          "tool_call": true,
        },
        "xiaomi/mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "reasoning": true,
          "tool_call": true,
        },
        "Qwen/Qwen3.7-Max": {
          "name": "Qwen 3.7 Max",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "reasoning": true,
          "tool_call": true,
        },
        "Qwen/Qwen3.7-Plus": {
          "name": "Qwen 3.7 Plus",
          "limit": {
            "context": 1048576,
            "output": 64000
          },
          "reasoning": true,
          "tool_call": true,
        },
        "stepfun/Step-3.7-Flash": {
          "name": "Step 3.7 Flash",
          "limit": {
            "context": 262144,
            "output": 256000
          },
          "reasoning": true,
          "tool_call": true,
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B",
          "limit": {
            "context": 131072,
            "output": 128000
          },
          "reasoning": true,
          "tool_call": true,
        },
      },
    },
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
  },
}