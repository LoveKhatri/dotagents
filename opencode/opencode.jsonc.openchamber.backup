{
  "plugin": [
    "opencode-antigravity-auth@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "default_agent": "plan",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
  },
}